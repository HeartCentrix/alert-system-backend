# Application Settings
APP_NAME=TM Alert
# development | production. production enforces Twilio signature validation,
# gates debug endpoints, and disables MFA_EXEMPT_EMAILS.
APP_ENV=development

# JWT Secret Keys (min 32 chars each, strong + random — these sign tokens)
# Generate each with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
REFRESH_SECRET_KEY=

# Dedicated key for MFA challenge tokens (5-minute JWTs issued during login).
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
MFA_CHALLENGE_SECRET_KEY=

# Dedicated key for safety check-in tokens (links emailed/SMSed to employees).
# Keeping this separate from SECRET_KEY means rotating it after a leaked
# check-in link does not invalidate every active session. Falls back to
# SECRET_KEY if unset.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
CHECKIN_SECRET_KEY=

# Token expiration settings
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Development-only MFA exemption: comma-separated emails that skip the
# role-based MFA requirement. Only honoured when APP_ENV=development.
# Leave empty in prod. Example: admin@tmalert.com,localdev@example.com
MFA_EXEMPT_EMAILS=

# Database Configuration
# POSTGRES_* are consumed by docker-compose to provision the local Postgres
# container; DATABASE_URL is what the app actually connects with. Keep them
# consistent (same user/password/db).
POSTGRES_USER=postgres
# REQUIRED: generate a strong password before first run. Example:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
# The Postgres container refuses to start with an empty password.
POSTGRES_PASSWORD=
POSTGRES_DB=tm_alert
# In Docker, the host is the compose service name "db". Running the app
# directly on the host instead? Use "localhost". Substitute the password set
# above.
DATABASE_URL=postgresql://postgres:REPLACE_ME@db:5432/tm_alert

# Redis Configuration (in Docker the host is the compose service name "redis")
REDIS_URL=redis://redis:6379/0

# Frontend/Backend URLs
# IMPORTANT: BACKEND_URL must include the scheme (http:// or https://). It is
# used to build Twilio webhook URLs and to verify Twilio signatures, so in
# production it must be the exact public https URL, e.g.
#   https://your-app.up.railway.app
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Number of trusted reverse-proxy hops in front of the app. Controls how the
# real client IP is derived from X-Forwarded-For for login rate limiting /
# lockout. 0 = trust none / app is exposed directly (default). 1 = single edge
# proxy (Railway / Vercel). 2 = nginx behind an edge proxy. MUST match the real
# deployment topology — setting it too high lets clients spoof their IP.
TRUSTED_PROXY_COUNT=0

# Twilio Configuration (SMS / voice notifications)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Optional: WhatsApp sender, e.g. whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=

# AWS SES Configuration (Email notifications)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
SES_FROM_EMAIL=noreply@tmalert.com
SES_FROM_NAME=TM Alert

# SMTP Configuration (Async email notifications)
EMAIL_FROM=security@tmalert.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Google Maps API (optional - for other map features)
GOOGLE_MAPS_API_KEY=

# ── Geocoding Provider ────────────────────────────────────────────────
# DEFAULT (demo — no key needed, global coverage):
GEOCODING_PROVIDER=photon_public

# Self-hosted Photon on Railway:
# GEOCODING_PROVIDER=photon_self
# GEOCODING_PROVIDER_URL=http://photon.railway.internal:2322

# Self-hosted Photon on VPS (production):
# GEOCODING_PROVIDER=photon_self
# GEOCODING_PROVIDER_URL=https://photon.yourdomain.com

GEOCODING_PROVIDER_URL=

# Optional LocationIQ API key (geocoding fallback)
LOCATIONIQ_API_KEY=

# MFA Encryption Key (Fernet key for encrypting MFA secrets at rest).
# REQUIRED — the app refuses to boot without a valid Fernet key.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=

# TOTP clock-skew tolerance, in 30s steps. 0 = current step only (most secure,
# recommended). 1 = allow one step either side. Higher values widen the window
# an attacker has to replay a captured code.
MFA_TOTP_VALID_WINDOW=0

# =============================================================================
# Authentication Providers Configuration
# =============================================================================
# Comma-separated list of enabled auth providers: local, entra, ldap
# - local: Email/password authentication
# - entra: Microsoft Entra ID (Azure AD) SSO
# - ldap: LDAP/Active Directory authentication
AUTH_PROVIDERS=local,entra,ldap

# Control individual provider availability (true/false). "local" is controlled
# via the AUTH_PROVIDERS list above.
ENTRA_ENABLED=true
LDAP_ENABLED=false

# =============================================================================
# Microsoft Entra ID (Azure AD) OAuth 2.0 / OIDC Configuration
# =============================================================================
# Required for Microsoft SSO login
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Use a specific tenant GUID (NOT "common") so only your tenant can sign in.
ENTRA_TENANT_ID=

# Must include https:// and match EXACTLY what's registered in Azure AD app
# registration (Authentication -> Redirect URIs).
# Format: http://localhost:8000/api/v1/auth/entra/callback (development)
#         https://yourdomain.com/api/v1/auth/entra/callback (production)
ENTRA_REDIRECT_URI=

# Space-separated OIDC scopes (default is fine for sign-in)
ENTRA_SCOPES=openid profile email

# =============================================================================
# LDAP / Active Directory Configuration
# =============================================================================
# Server URL with protocol (ldap:// or ldaps:// for secure)
LDAP_SERVER_URL=ldaps://ad.company.com:636

# Service account credentials for LDAP binding
# Use a dedicated service account with read-only access to user directory
LDAP_BIND_DN=cn=tmalert-service,ou=ServiceAccounts,dc=company,dc=com
LDAP_BIND_PASSWORD=

# Base DN where user accounts are located
LDAP_USER_SEARCH_BASE=ou=Users,dc=company,dc=com

# LDAP search filter to find user by username ({username} is substituted)
#   Active Directory: (&(objectClass=user)(sAMAccountName={username}))
#   OpenLDAP:         (&(objectClass=person)(uid={username}))
LDAP_USER_SEARCH_FILTER=(&(objectClass=user)(sAMAccountName={username}))

# Attribute mappings for user information
LDAP_EMAIL_ATTRIBUTE=mail
LDAP_FIRST_NAME_ATTRIBUTE=givenName
LDAP_LAST_NAME_ATTRIBUTE=sn

# Use TLS for the LDAP connection (recommended)
LDAP_USE_TLS=true

# Optional: restrict LDAP login to members of a group.
# LDAP_GROUP_SEARCH_BASE=ou=Groups,dc=company,dc=com
# LDAP_REQUIRED_GROUP=cn=TM-Alert-Users,ou=Groups,dc=company,dc=com
LDAP_GROUP_SEARCH_BASE=
LDAP_REQUIRED_GROUP=

# =============================================================================
# Security / Provisioning Settings
# =============================================================================
# Allowed email domains for login + SSO auto-provisioning (optional).
# Comma-separated. Leave empty to allow any domain. REQUIRED to be non-empty
# when an external provider (Entra/LDAP) has AUTO_PROVISION_USERS=true, or the
# app refuses to boot.
# Example: ALLOWED_EMAIL_DOMAINS=company.com,subsidiary.com
ALLOWED_EMAIL_DOMAINS=

# Auto-provision users on first SSO/LDAP login (true/false).
# If false, users must be created by an admin before they can log in.
AUTO_PROVISION_USERS=true

# =============================================================================
# Bootstrap super admin (optional)
# =============================================================================
# On first boot with an empty users table, a super admin is seeded with a
# RANDOM one-time password written to BOOTSTRAP_PW_FILE (read it once, then the
# app forces a rotation). Override the defaults only if needed.
# BOOTSTRAP_ADMIN_EMAIL=admin@tmalert.com
# BOOTSTRAP_PW_FILE=/run/secrets/bootstrap_pw
